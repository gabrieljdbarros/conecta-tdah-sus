# Copie para .env.local (que NÃO vai para o Git).

# Modo protótipo: usa os emuladores do Firebase rodando no computador
EXPO_PUBLIC_USE_EMULATORS=true
# Endereço do computador na rede Wi-Fi/cabo (ipconfig → IPv4). O celular
# precisa estar na mesma rede
EXPO_PUBLIC_EMULADOR_HOST=192.168.1.3

# Projeto real (só quando EXPO_PUBLIC_USE_EMULATORS=false)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
