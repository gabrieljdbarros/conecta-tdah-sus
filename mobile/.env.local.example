# Copie para .env.local (que NÃO vai para o Git).

# SUPABASE rodando no computador (`npx supabase start`, na raiz do projeto).
# Use o endereço do computador na rede Wi-Fi/cabo (ipconfig → IPv4), porque
# o celular não enxerga "localhost". O celular precisa estar na mesma rede.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.3:54321
# A "anon key" do `npx supabase status` (ANON_KEY). É pública por natureza:
# quem protege os dados é o RLS. NUNCA coloque aqui a chave service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Endereço do site, usado nos links (convite e "esqueci minha senha").
# Sem isto: http://<mesmo IP do Supabase>:3000
# EXPO_PUBLIC_SITE_URL=
