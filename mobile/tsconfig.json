{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/types/*": [
        "../src/types/*"
      ],
      "@/helpers/voz": [
        "../src/helpers/voz"
      ],
      "@/helpers/pasta": [
        "../src/helpers/pasta"
      ],
      "@/helpers/linhas": [
        "../src/helpers/linhas"
      ],
      "@/helpers/convite": [
        "../src/helpers/convite"
      ],
      "@/helpers/questionario": [
        "../src/helpers/questionario"
      ],
      "@/helpers/recentes": [
        "../src/helpers/recentes"
      ],
      "@/helpers/sobre": [
        "../src/helpers/sobre"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
