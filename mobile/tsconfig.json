{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/types/*": [
        "../src/types/*"
      ],
      "@/helpers/semana": [
        "../src/helpers/semana"
      ],
      "@/helpers/voz": [
        "../src/helpers/voz"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
