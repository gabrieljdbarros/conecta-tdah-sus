rules_version = '2';

/**
 * REGRAS DE SEGURANÇA — CONECTA TDAH SUS
 *
 * Decisão travada: o `role` (admin | mae | escola | medico) fica em um campo
 * no Firestore (`users/{uid}.role`), não em custom claims do Firebase Auth.
 * Estas regras são a aplicação real do RBAC — o app só reflete o que elas
 * permitem, então qualquer checagem feita na tela é apenas UX.
 *
 * Coleções cobertas: `users` (cadastro/perfil), `pastas` (pasta do aluno,
 * RF03) com os relatórios (RN06), `convites` (RN01, RN02) e `categorias`
 * (RF14). O chat (RN05) será adicionado aqui quando for implementado — até
 * lá, o bloqueio geral no fim do arquivo nega qualquer acesso a ele.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function meuUid() {
      return request.auth.uid;
    }

    function papelDoUsuario(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function souAdmin() {
      return estaLogado() && papelDoUsuario(meuUid()) == 'admin';
    }

    // ---------------------------------------------------------------------
    // VALIDAÇÃO DO CONTEÚDO DO PERFIL
    // Espelha o Yup dos formulários: o banco não aceita o que a tela nunca
    // mandaria (chaves de outro perfil, tipos errados, textos gigantes),
    // mesmo que alguém chame o SDK direto, sem passar pela tela.
    // ---------------------------------------------------------------------
    // trim(): texto feito só de espaços não conta como preenchido
    function textoValido(valor) {
      return valor is string && valor.trim().size() > 0 && valor.size() <= 100;
    }

    // Exatamente os campos do perfil (decisão travada nº 4), todos texto
    // O nome da criança NÃO fica no perfil da mãe (o admin lê perfis):
    // ele existe só na pasta do aluno, que o admin não lê
    function perfilMaeValido(dp) {
      return dp.keys().hasOnly(['grauParentesco'])
          && textoValido(dp.grauParentesco);
    }

    // `disciplina` é opcional: coordenação/direção não leciona. Se vier,
    // precisa ser texto válido (a tela omite o campo quando fica vazio)
    function perfilEscolaValido(dp) {
      return dp.keys().hasOnly(['nomeEscola', 'cargo', 'disciplina'])
          && textoValido(dp.nomeEscola)
          && textoValido(dp.cargo)
          && (!('disciplina' in dp) || textoValido(dp.disciplina));
    }

    function perfilMedicoValido(dp) {
      return dp.keys().hasOnly(['crm', 'especialidade', 'unidadeSUS'])
          && textoValido(dp.crm)
          && textoValido(dp.especialidade)
          && textoValido(dp.unidadeSUS);
    }

    // `role` é passado por quem chama: no create vem do próprio documento
    // (já restrito a mae/escola/medico); no update vem do documento SALVO,
    // nunca do que o cliente enviou
    function perfilValido(dados, role) {
      return textoValido(dados.nome)
          && dados.dadosPerfil is map
          && ((role == 'mae' && perfilMaeValido(dados.dadosPerfil))
              || (role == 'escola' && perfilEscolaValido(dados.dadosPerfil))
              || (role == 'medico' && perfilMedicoValido(dados.dadosPerfil))
              || (role == 'admin' && dados.dadosPerfil.keys().size() == 0));
    }

    match /users/{userId} {
      // Qualquer pessoa autenticada pode ler o próprio perfil; admin lê todos
      // (necessário para a listagem do painel admin)
      allow read: if estaLogado() && (meuUid() == userId || souAdmin());

      // Cadastro: só é permitido criar o próprio documento, no momento do
      // signup (createUserWithEmailAndPassword + setDoc acontecem em sequência)
      // O documento precisa ter exatamente os campos do modelo, com conteúdo
      // válido para o perfil escolhido
      allow create: if estaLogado()
                    && meuUid() == userId
                    && request.resource.data.keys().hasOnly(['nome', 'email', 'role', 'dadosPerfil', 'criadoEm'])
                    && request.resource.data.keys().hasAll(['nome', 'email', 'role', 'dadosPerfil', 'criadoEm'])
                    && request.resource.data.role in ['mae', 'escola', 'medico']
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.criadoEm is int
                    && perfilValido(request.resource.data, request.resource.data.role);

      // Edição: o próprio usuário ou o admin, e SÓ `nome` e `dadosPerfil`,
      // com o conteúdo validado conforme o perfil salvo.
      // Ninguém altera `role`, `email` ou `criadoEm` pelo app — nem o admin:
      // trocar uma escola para médico daria acesso a laudos (matriz de
      // visibilidade dos relatórios, RN06).
      // Mudança de perfil, se precisar, é feita no Console do Firebase.
      allow update: if estaLogado()
                    && (meuUid() == userId || souAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'dadosPerfil'])
                    && perfilValido(request.resource.data, resource.data.role);

      allow delete: if souAdmin();
    }

    // ---------------------------------------------------------------------
    // PASTA DO ALUNO (RF03) — decisões travadas 6 e 8
    // ---------------------------------------------------------------------
    function serieValida(serie) {
      return serie in ['infantil', 'ef1', 'ef2', 'ef3', 'ef4', 'ef5', 'ef6',
                       'ef7', 'ef8', 'ef9', 'em1', 'em2', 'em3'];
    }

    // ---------------------------------------------------------------------
    // RELATÓRIOS (decisão travada 9 / RN06) — funções de apoio
    // ---------------------------------------------------------------------
    function dadosDaPasta(pastaId) {
      return get(/databases/$(database)/documents/pastas/$(pastaId)).data;
    }

    // Papel NA PASTA: a mãe é a DONA (não basta ter role 'mae'); escola e
    // médico precisam ser membros e ter esse role no perfil. Qualquer outra
    // pessoa (inclusive o admin e quem saiu da pasta) fica sem papel
    function papelNaPasta(pasta) {
      return (meuUid() == pasta.donoUid && meuUid() in pasta.membrosUids) ? 'mae'
           : (meuUid() in pasta.membrosUids && papelDoUsuario(meuUid()) in ['escola', 'medico']) ? papelDoUsuario(meuUid())
           : 'nenhum';
    }

    // Matriz de leitura: a escola vê só o pedagógico; laudo e relato da
    // família ficam entre a mãe e o médico
    function tiposQueLe(papel) {
      return papel == 'escola' ? ['orientacao_medica', 'avaliacao_escolar']
           : papel in ['mae', 'medico'] ? ['orientacao_medica', 'laudo', 'avaliacao_escolar', 'relato_familia']
           : [];
    }

    function tiposQueEscreve(papel) {
      return papel == 'mae' ? ['relato_familia']
           : papel == 'medico' ? ['orientacao_medica', 'laudo']
           : papel == 'escola' ? ['avaliacao_escolar']
           : [];
    }

    match /pastas/{pastaId} {
      // Só quem é membro da pasta lê. O admin NÃO lê: a pasta vai guardar
      // laudos e relatos de crianças, e o admin não participa do
      // acompanhamento (LGPD — acesso só por necessidade).
      // Consultas de lista precisam filtrar por `membrosUids array-contains`
      allow read: if estaLogado() && meuUid() in resource.data.membrosUids;

      // Só a mãe/responsável cria, como dona e única membro inicial.
      // `participantes` é o resumo público de quem está na pasta (nome e
      // papel), para todos os membros saberem com quem estão falando: a mãe
      // entra com o nome igual ao do próprio perfil; escola/médico são
      // adicionados pela Cloud Function do convite
      allow create: if estaLogado()
                    && papelDoUsuario(meuUid()) == 'mae'
                    && request.resource.data.keys().hasOnly(['nomeAluno', 'serie', 'donoUid', 'membrosUids', 'participantes', 'criadoEm'])
                    && request.resource.data.keys().hasAll(['nomeAluno', 'serie', 'donoUid', 'membrosUids', 'participantes', 'criadoEm'])
                    && request.resource.data.donoUid == meuUid()
                    && request.resource.data.membrosUids == [meuUid()]
                    && request.resource.data.participantes.keys().hasOnly([meuUid()])
                    && request.resource.data.participantes[meuUid()] == {
                         'nome': get(/databases/$(database)/documents/users/$(meuUid())).data.nome,
                         'papel': 'mae'
                       }
                    && textoValido(request.resource.data.nomeAluno)
                    && serieValida(request.resource.data.serie)
                    && request.resource.data.criadoEm is int;

      // A dona só altera nome e série (a série muda todo ano).
      // `membrosUids` e `participantes` nunca mudam pelo navegador: quem adiciona escola/médico
      // é a Cloud Function do convite (RN01, RN02), que usa o Admin SDK
      // A dona também precisa continuar membro: se um dia for removida de
      // `membrosUids`, perde a edição junto com a leitura
      allow update: if estaLogado()
                    && resource.data.donoUid == meuUid()
                    && meuUid() in resource.data.membrosUids
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomeAluno', 'serie'])
                    && textoValido(request.resource.data.nomeAluno)
                    && serieValida(request.resource.data.serie);

      // TODO: exclusão da pasta a pedido da família (direito do titular na
      // LGPD) — definir fluxo, inclusive o que acontece com os relatórios
      allow delete: if false;

      // -------------------------------------------------------------------
      // RELATÓRIOS da pasta: `pastas/{pastaId}/relatorios/{id}`
      // Quem lê é decidido SÓ pelo `tipo` (nunca pela categoria, que é
      // editável pelo admin e só classifica o conteúdo).
      // -------------------------------------------------------------------
      match /relatorios/{relatorioId} {
        // Consultas de lista precisam filtrar `tipo in [tipos que o papel lê]`
        allow read: if estaLogado()
                    && resource.data.tipo in tiposQueLe(papelNaPasta(dadosDaPasta(pastaId)));

        // O autor é quem está logado, com o nome igual ao do perfil e o
        // papel que tem na pasta; a categoria precisa existir e estar ativa
        allow create: if estaLogado()
                      && request.resource.data.keys().hasOnly(['tipo', 'categoriaId', 'texto', 'autorUid', 'autorNome', 'autorPapel', 'criadoEm'])
                      && request.resource.data.keys().hasAll(['tipo', 'categoriaId', 'texto', 'autorUid', 'autorNome', 'autorPapel', 'criadoEm'])
                      && request.resource.data.tipo in tiposQueEscreve(papelNaPasta(dadosDaPasta(pastaId)))
                      && request.resource.data.autorPapel == papelNaPasta(dadosDaPasta(pastaId))
                      && request.resource.data.autorUid == meuUid()
                      && request.resource.data.autorNome == get(/databases/$(database)/documents/users/$(meuUid())).data.nome
                      && request.resource.data.texto is string
                      && request.resource.data.texto.trim().size() > 0
                      && request.resource.data.texto.size() <= 5000
                      && request.resource.data.criadoEm is int
                      && request.resource.data.categoriaId is string
                      && get(/databases/$(database)/documents/categorias/$(request.resource.data.categoriaId)).data.ativa == true;

        // Registro imutável: ninguém edita nem apaga. Correção = novo
        // relatório complementar. Relatórios de quem saiu da pasta ficam
        // (o nome do autor está guardado no próprio relatório)
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // CONVITES (RN01, RN02) — `convites/{hash do token}`
    // Criados e usados só pelas Cloud Functions (Admin SDK). O id do
    // documento é o hash do token, então ler o convite NÃO revela o link.
    // ---------------------------------------------------------------------
    match /convites/{conviteId} {
      // Quem criou (a dona da pasta) vê e cancela os próprios convites.
      // Consultas de lista precisam filtrar por `criadoPor == uid`.
      // Só cancela convite ainda NÃO usado: o usado é o registro de quem
      // entrou na pasta e por qual link
      allow read: if estaLogado() && resource.data.criadoPor == meuUid();
      allow delete: if estaLogado() && resource.data.criadoPor == meuUid() && resource.data.usadoEm == null;
      allow create, update: if false;
    }

    // ---------------------------------------------------------------------
    // CATEGORIAS DE ACOMPANHAMENTO (RF14, CSU15, RN10)
    // Só classificam o conteúdo dos relatórios: NUNCA controlam quem lê
    // (quem lê é definido pelo tipo do relatório — RN06).
    // ---------------------------------------------------------------------
    function nomeCategoriaValido(nome) {
      return nome is string && nome.trim().size() > 0 && nome.size() <= 60;
    }

    match /categorias/{categoriaId} {
      // Qualquer pessoa logada lê: mãe, escola e médico escolhem a
      // categoria ao escrever um relatório. Não são dados sensíveis
      allow read: if estaLogado();

      // Só o admin cria e edita
      allow create: if souAdmin()
                    && request.resource.data.keys().hasOnly(['nome', 'ativa', 'criadoEm'])
                    && request.resource.data.keys().hasAll(['nome', 'ativa', 'criadoEm'])
                    && nomeCategoriaValido(request.resource.data.nome)
                    && request.resource.data.ativa is bool
                    && request.resource.data.criadoEm is int;
      allow update: if souAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'ativa'])
                    && nomeCategoriaValido(request.resource.data.nome)
                    && request.resource.data.ativa is bool;

      // Ninguém apaga: relatórios antigos continuam apontando para a
      // categoria. Em vez de apagar, o admin desativa (ativa = false)
      allow delete: if false;
    }

    // Bloqueia qualquer coleção ainda não modelada explicitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
