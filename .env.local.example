# Copie este arquivo para ".env.local" (não versionado).

# SUPABASE (banco, login e tempo real do site)
# Desenvolvimento: rode `npx supabase start` e copie de `npx supabase status`
# a "Project URL"/API_URL e a "anon key"/ANON_KEY. A chave anon é pública por
# natureza (quem protege os dados é o RLS do banco). NUNCA coloque aqui a
# chave service_role.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
